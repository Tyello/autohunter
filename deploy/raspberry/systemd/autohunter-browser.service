[Unit]
Description=AutoHunter Browser Service (Playwright)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=autohunter
WorkingDirectory=/opt/autohunter
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/autohunter/.env
ExecStart=/opt/autohunter/deploy/raspberry/scripts/run_browser_service.sh
Restart=always
RestartSec=3

# See autohunter-scheduler.service for why this is needed.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
